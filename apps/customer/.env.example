# ==============================================================================
# Customer Frontend Environment Variables Template
# ==============================================================================
# To override for local testing against a remote backend without modifying git files,
# copy this file to `.env.local` (which is ignored by Git).
#
# Examples:
# For local dev backend:
#   VITE_API_URL=
#   VITE_WS_URL=http://localhost:4000
#
# For hosted staging/production backend:
#   VITE_API_URL=https://api.sanitary.app
#   VITE_WS_URL=https://api.sanitary.app

VITE_API_URL=
VITE_WS_URL=http://localhost:4000
